# Exemple de configuration du service RAG sur le serveur SIE (à adapter, ne pas versionner le vrai fichier)
SIE_RAG_ARCHIVES=\\SRV-FICHIERS\Memoires
SIE_RAG_DONNEES=D:\SIE\rag\donnees
SIE_RAG_BASE=postgresql://rag:MOT_DE_PASSE@localhost/sie_rag
SIE_RAG_MODELES=D:\SIE\rag\modeles
SIE_RAG_ENCODEUR=bge-m3
SIE_RAG_RECLASSEUR=aucun
SIE_RAG_DROITS=ntfs
# Règle des mémoires validés : à remplacer par celle de SIE (dossier, nommage ou statut)
SIE_RAG_MOTIF_VALIDES=valid|d[ée]finitif|final|rendu|envoy
SIE_RAG_EXCLUSIONS=
SIE_RAG_JETON=CHAINE_ALEATOIRE_LONGUE
SIE_RAG_GROUPES_ADMIN=SIE\Admin-RAG
SIE_RAG_HEURE_SYNCHRO=02:00
# IA de rédaction : rester sur « aucun » tant que l'accord écrit de SIE n'est pas reçu
SIE_LLM=aucun
SIE_LLM_EXTERNE_AUTORISE=non
SIE_AWS_REGION=eu-west-3
